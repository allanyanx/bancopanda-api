@BancoPanda.Api_HostAddress = http://localhost:5258

### Registro
POST {{BancoPanda.Api_HostAddress}}/api/auth/registro
Content-Type: application/json

{
  "cedula": "1234567890",
  "nombres": "Andrea",
  "apellidos": "Barroso Torres",
  "correo": "prueba@bancopanda.test",
  "telefono": "0987654321",
  "contrasena": "Panda2026",
  "aceptaTerminos": true
}

### Login con correo
# @name login
POST {{BancoPanda.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "identificador": "prueba@bancopanda.test",
  "contrasena": "Panda2026"
}

### Login con cédula
POST {{BancoPanda.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "identificador": "1234567890",
  "contrasena": "Panda2026"
}

### Ver mi perfil (ejecuta antes "Login con correo")
@token = {{login.response.body.$.token}}
GET {{BancoPanda.Api_HostAddress}}/api/usuarios/perfil
Authorization: Bearer {{token}}

### Editar mi perfil
PUT {{BancoPanda.Api_HostAddress}}/api/usuarios/perfil
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombres": "Andrea Melina",
  "apellidos": "Barroso Torres",
  "correo": "prueba@bancopanda.test",
  "telefono": "0987654321"
}

### Cambiar mi contraseña
PUT {{BancoPanda.Api_HostAddress}}/api/usuarios/perfil
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombres": "Andrea",
  "apellidos": "Barroso Torres",
  "correo": "prueba@bancopanda.test",
  "telefono": "0987654321",
  "contrasenaActual": "Panda2026",
  "contrasenaNueva": "Panda2027"
}

### Sin token: debe responder 401
GET {{BancoPanda.Api_HostAddress}}/api/usuarios/perfil
